{
  "name": "get-it",
  "version": "9.5.2",
  "description": "Generic HTTP request library for node, browsers and workers",
  "keywords": [
    "fetch",
    "http",
    "request"
  ],
  "homepage": "https://github.com/sanity-io/get-it#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/get-it/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/get-it.git"
  },
  "files": [
    "dist",
    "!dist/*.min.*",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/vitest.js",
    "./src/_exports/vitest.ts"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": "./dist/index.js",
      "deno": "./dist/index.js",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "node": "./dist/index.node.js",
      "bun": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./middleware": "./dist/middleware.js",
    "./mock": "./dist/mock.js",
    "./node": "./dist/node.js",
    "./vitest": "./dist/vitest.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run format && pnpm run lint:fix && pnpm run knip && pnpm run typecheck",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "report-size": "scripts/report-size.sh",
    "test": "vitest run",
    "test:all": "pnpm run test && pnpm run test:happy-dom && pnpm run test:jsdom && pnpm run test:bun && pnpm run test:deno && pnpm run test:vercel-edge && pnpm run test:react-server && pnpm run test:workerd && pnpm run test:smoke",
    "test:browser": "pnpm test --config ./test/config/vitest.browser.config.ts",
    "test:bun": "bun run vitest run",
    "test:deno": "pnpm run build && deno test --no-lock test/deno/smoke.ts",
    "test:happy-dom": "pnpm test --config ./test/config/vitest.happy-dom.config.ts --dom",
    "test:jsdom": "pnpm test --config ./test/config/vitest.jsdom.config.ts",
    "test:react-server": "pnpm test --config ./test/config/vitest.react-server.config.ts",
    "test:smoke": "pnpm run build && pnpm run test:smoke:workerd && pnpm run test:smoke:vercel-edge && pnpm run test:smoke:react-server && pnpm run test:smoke:happy-dom && pnpm run test:smoke:jsdom && pnpm run test:smoke:browser && pnpm run test:smoke:bun",
    "test:smoke:browser": "pnpm test --config ./test/config/vitest.browser.smoke.config.ts",
    "test:smoke:bun": "bun run vitest run --config ./test/config/vitest.bun.smoke.config.ts",
    "test:smoke:happy-dom": "pnpm test --config ./test/config/vitest.happy-dom.smoke.config.ts",
    "test:smoke:jsdom": "pnpm test --config ./test/config/vitest.jsdom.smoke.config.ts",
    "test:smoke:react-server": "pnpm test --config ./test/config/vitest.react-server.smoke.config.ts",
    "test:smoke:vercel-edge": "pnpm test --config ./test/config/vitest.vercel-edge.smoke.config.ts",
    "test:smoke:workerd": "pnpm test --config ./test/config/vitest.workerd.smoke.config.ts",
    "test:vercel-edge": "pnpm test --config ./test/config/vitest.vercel-edge.config.ts",
    "test:workerd": "pnpm test --config ./test/config/vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.check-node.json"
  },
  "dependencies": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@edge-runtime/vm": "^5.0.0",
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.27.1",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.13.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "ls-engines": "^0.10.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "browserslist": [
    "node >= 22.12.0",
    "> 0.27%",
    "not dead",
    "not op_mini all",
    "not ios_saf < 14.1",
    "not safari < 14.1"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.1"
}
